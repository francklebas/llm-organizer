{
  "manifest_version": 3,
  "name": "AI Conversation Organizer",
  "version": "0.0.1",
  "description": "Organisez vos conversations ChatGPT, Claude et Gemini dans un workspace personnel qui vous appartient.",
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "sidebar_action": {
    "default_title": "AI Organizer",
    "default_panel": "sidebar.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content-chatgpt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content-claude.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-conversation-organizer@local",
      "strict_min_version": "115.0"
    }
  }
}
